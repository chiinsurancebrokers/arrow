# Required: Claude API key for HAL's explainer layer
ANTHROPIC_API_KEY=

# Optional: override the model HAL uses (defaults to claude-sonnet-4-6)
HAL_MODEL=claude-sonnet-4-6

# Optional, temporary: set to 1 to echo the real exception in HAL's error
# response while debugging a deploy. Turn this back off (unset, or 0) once
# HAL is working -- it can leak internal details to end users otherwise.
HAL_DEBUG=0
