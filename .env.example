# HAL provider 1: Claude
ANTHROPIC_API_KEY=
HAL_MODEL=claude-sonnet-4-6

# HAL provider 2: OpenAI automatic fallback
OPENAI_API_KEY=
HAL_OPENAI_MODEL=gpt-5.6-luna

# AI request controls
HAL_REQUEST_TIMEOUT=30
HAL_MAX_OUTPUT_TOKENS=550
HAL_FULL_POLICY_EXCERPTS=4
HAL_FULL_POLICY_MAX_CHARS=7000

# Employee anti-overuse guard (AI-backed questions only).
# Deterministic emergency contacts, claim instructions and simple limits remain available.
HAL_EMPLOYEE_COOLDOWN_SECONDS=3
HAL_EMPLOYEE_SESSION_10MIN=6
HAL_EMPLOYEE_SESSION_DAILY=20
HAL_EMPLOYEE_IP_HOURLY=50
HAL_EMPLOYEE_IP_DAILY=150
HAL_GLOBAL_AI_DAILY=200

# Admin access keys. Use long random values in Railway; never commit real keys.
ARROW_ADMIN_KEY=
CHI_ADMIN_KEY=

# Temporary troubleshooting only. Do not leave enabled in production.
HAL_DEBUG=0
